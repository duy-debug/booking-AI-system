# LLM / GEMINI
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_RETRIES=0
DIALOG_INTENT_TOOL_ENABLED=true
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0

# EMBEDDING / RAG
EMBED_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_MODEL_PATH=
EMBED_MODEL_VERSION=multilingual-minilm-l12-v2-1
EMBED_DIM=384
EMBED_FALLBACK_ENABLED=true
RAG_VECTOR_CANDIDATE_LIMIT=30
RAG_LEXICAL_CANDIDATE_LIMIT=500
RAG_VECTOR_WEIGHT=0.25
RAG_HYBRID_SCORE_THRESHOLD=0.45

# QDRANT
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=kb_chunks
KNOWLEDGE_QDRANT_ENABLED=false

# CONVERSATION
CONVERSATION_TTL_SECONDS=1800
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh

# POS
BOOKING_API_URL=http://127.0.0.1:8000
BOOKING_API_SERVICE_KEY=
BOOKING_API_TIMEOUT_SECONDS=10

# APPLICATION
ADMIN_API_KEY=change-me-in-production
APP_NAME=Booking AI Chatbot
APP_VERSION=0.1.0
CHATBOT_DEBUG=false
CORS_ORIGINS=http://localhost:3002
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
CONTRACT_VERSION=1.0
SSE_TOKEN_DELAY_MS=14
MAX_AUDIO_UPLOAD_BYTES=10485760

# LOGGING
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_FORMAT=console
LOG_JSON_PATH=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_FULL_INSTRUCTIONS=false
LOG_RAW_CHAT_MESSAGES=false
LOG_RAW_CHAT_RESPONSES=false
